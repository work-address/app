# Ignore node_modules and build outputs (used when building from repo root)
**/node_modules/
**/dist/
**/out/
**/.next/
**/.tmp/
**/.cache/

# Ignore Git and IDE
.git/
.gitignore
.vscode/
.idea/

# Ignore logs and debug
*.log
# Match nested paths (e.g. api/tsconfig.tsbuildinfo); plain *.tsbuildinfo does not
**/*.tsbuildinfo

# api/ source is required for the API image build; **/node_modules/ already trims bulk
