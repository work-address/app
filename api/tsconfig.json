{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "rootDir": "./src",
    "target": "ES2018",
    "module": "commonjs",
    "sourceMap": true,
    "outDir": "./build",
    "strictPropertyInitialization": false,
    "noImplicitReturns": true,
    "moduleResolution": "node",
    "inlineSources": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules", "build", "dist"]
}

