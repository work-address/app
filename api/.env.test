NODE_ENV=test
APP_HOST=0.0.0.0
APP_PORT=4000
APP_SENTRY=
APP_LOGGLY=
APP_REDIS=redis://localhost:6379
APP_JWT_SECRET=dev-secret-change-in-production

# Presence of this secret is what puts the instance in SaaS mode, where
# `user.premium` gates collaborators and history. The suite asserts that
# gating, so it must be set here - with it empty every test account would be
# treated as self-hosted and therefore unconditionally premium.
APP_ENTITLEMENT_SECRET=test-entitlement-secret

APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USERNAME=ivan
APP_DB_PASSWORD=
APP_DB_NAME=address_work_test

APP_GOOGLE_CLIENT_ID=test-google-client-id.apps.googleusercontent.com
