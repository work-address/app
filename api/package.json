{
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prod": "NODE_ENV=production node build/server.js",
    "dev": "HTTPS=true NODE_ENV=development TS_NODE_PROJECT=tsconfig.json ts-node-dev -r tsconfig-paths/register --inspect --respawn src/server.ts",
    "export-openapi": "NODE_ENV=test TS_NODE_PROJECT=tsconfig.json TS_NODE_TRANSPILE_ONLY=1 ts-node -r tsconfig-paths/register -r ts-node/register src/scripts/export-openapi-spec.ts",
    "test": "NODE_ENV=test TS_NODE_PROJECT=tsconfig.json nyc ./node_modules/.bin/mocha -r tsconfig-paths/register -r ts-node/register ./src/test/**/**/**/**/*.test.ts",
    "build": "rimraf build tsconfig.tsbuildinfo && tsc -p tsconfig.json",
    "prettier:fix": "prettier --write \"**/*.{ts,js,md}\"",
    "prettier:check": "prettier --check \"**/*.{ts,js,md}\"",
    "typeorm:cli": "TS_NODE_PROJECT=tsconfig.json ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "schema:sync": "TS_NODE_PROJECT=tsconfig.json ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js schema:sync -d src/ormconfig.ts",
    "schema:drop": "TS_NODE_PROJECT=tsconfig.json ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js schema:drop -d src/ormconfig.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.71.0",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.4",
    "bs58": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "class-validator-jsonschema": "^5.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "inversify": "^7.11.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.3",
    "openapi3-ts": "^3.2.0",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3",
    "routing-controllers-openapi": "^5.0.1",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1",
    "tweetnacl": "^1.0.3",
    "typeorm": "^1.1.0",
    "web3": "^4.16.0",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@app/api-client": "workspace:*",
    "@app/eslint-config": "workspace:*",
    "@eslint/js": "9.22.0",
    "@faker-js/faker": "^10.6.0",
    "@testdeck/mocha": "^0.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/chai": "^4.3.20",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.25",
    "@types/mocha": "^9.1.1",
    "@types/node": "^26.3.0",
    "chai": "^4.5.0",
    "eslint": "^9.39.4",
    "mocha": "^9.2.2",
    "nock": "^14.0.17",
    "node-mocks-http": "^1.18.1",
    "nyc": "^15.1.0",
    "prettier": "^2.8.8",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
