{
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prod": "NODE_ENV=production node build/server.js",
    "dev": "HTTPS=true NODE_ENV=development TS_NODE_PROJECT=tsconfig.json ts-node-dev -r tsconfig-paths/register --inspect --respawn src/server.ts",
    "export-openapi": "NODE_ENV=test TS_NODE_PROJECT=tsconfig.json TS_NODE_TRANSPILE_ONLY=1 ts-node -r tsconfig-paths/register -r ts-node/register src/scripts/export-openapi-spec.ts",
    "test": "NODE_ENV=test TS_NODE_PROJECT=tsconfig.json nyc ./node_modules/.bin/mocha -r tsconfig-paths/register -r ts-node/register ./src/test/**/**/**/**/*.test.ts",
    "build": "rimraf build tsconfig.tsbuildinfo && tsc -p tsconfig.json",
    "prettier:fix": "prettier --write \"**/*.{ts,js,md}\"",
    "prettier:check": "prettier --check \"**/*.{ts,js,md}\"",
    "typeorm:cli": "TS_NODE_PROJECT=tsconfig.json ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli -f src/ormconfig.ts"
  },
  "dependencies": {
    "@sentry/node": "^6.19.7",
    "@sentry/tracing": "^6.19.7",
    "@ton/core": "^0.63.0",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^13.11.2",
    "axios": "^0.25.0",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "class-validator-jsonschema": "^5.1.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "express-query-boolean": "^2.0.0",
    "inversify": "^6.2.2",
    "inversify-inject-decorators": "^3.1.0",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "openapi3-ts": "^3.2.0",
    "pg": "^8.20.0",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3",
    "routing-controllers-openapi": "^5.0.1",
    "sharp": "^0.34.0",
    "swagger-ui-express": "^4.6.3",
    "tweetnacl": "^1.0.3",
    "typeorm": "^0.2.45",
    "web3": "^4.16.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@app/api-client": "workspace:*",
    "@app/eslint-config": "workspace:*",
    "@eslint/js": "9.22.0",
    "@testdeck/mocha": "^0.2.2",
    "@types/bcrypt": "^5.0.2",
    "@types/body-parser": "^1.19.6",
    "@types/chai": "^4.3.20",
    "@types/express": "^4.17.25",
    "@types/faker": "^5.5.9",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/lodash": "^4.17.24",
    "@types/mocha": "^9.1.1",
    "@types/moment": "^2.13.0",
    "@types/node": "^18.19.130",
    "@types/sharp": "^0.31.1",
    "chai": "^4.5.0",
    "eslint": "^9.39.4",
    "faker": "^5.5.3",
    "mocha": "^9.2.2",
    "prettier": "^2.8.8",
    "nock": "^13.5.6",
    "node-mocks-http": "^1.17.2",
    "nyc": "^15.1.0",
    "rimraf": "^3.0.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
