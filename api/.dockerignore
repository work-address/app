# Ignore dependencies and build output
node_modules/
dist/
out/
.tmp/
.cache/

# Ignore environment and config files (sensitive data)
*.env*
*.log

# Ignore TypeScript build artifacts (nested name must use **/)
**/*.tsbuildinfo

# Ignore lockfile debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ignore local development files
.git/
.gitignore
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Ignore Docker-related files
dockerfile*
.dockerignore
docker-compose*.yml
