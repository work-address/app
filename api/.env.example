NODE_ENV=production
APP_HOST=0.0.0.0
APP_PORT=4000
APP_SENTRY=
# Loggly: subdomain/customer-token (leave empty to disable)
APP_LOGGLY=
APP_REDIS=redis://host.docker.internal:6379
APP_JWT_SECRET=dev-secret-change-in-production

# Shared secret for the entitlement push from the billing service. Must hold
# the SAME value as APP_ENTITLEMENT_SECRET there - it is an HMAC key over the
# push body, so a mismatch does not fail loudly: pushes are rejected as
# unauthenticated and entitlement silently stops flowing.
#
# LEAVE EMPTY when self-hosting: no billing service means every account is
# unconditionally premium, which is the intended behaviour for this build.
APP_ENTITLEMENT_SECRET=

APP_DB_HOST=host.docker.internal
APP_DB_PORT=5432
APP_DB_USERNAME=postgres
APP_DB_PASSWORD=postgres
APP_DB_NAME=address_work

# Must match the host of VITE_API_URL (docker-compose*.yml web service). Comma-separated, no scheme.
APP_TON_ALLOWED_DOMAINS=
# Portable identity: the IdentityRegistry profile commitments are anchored to,
# read-only (eth_call, eth_getLogs) - this service never sends a transaction.
# Chain id, registry and RPC URL together enable it; leave any of them empty
# and GET /api/identity/config reports enabled: false. For the local Hardhat
# node (contracts: `npm run node`, then `npm run deploy:localhost`), use chain
# 31337 and the identityRegistry address in deployments/localhost.json.
# There is no public deployment yet: the registry is unaudited (SPEC §14).
APP_IDENTITY_CHAIN_ID=
APP_IDENTITY_REGISTRY_ADDRESS=
# Never exposed by any endpoint, so it may carry a provider key.
APP_IDENTITY_RPC_URL=
# Where the release manifest naming this registry is published; optional.
APP_IDENTITY_MANIFEST_URL=
# The registry's deployment block (deployBlock in the deploy manifest): where
# the version-history event scan starts. 0 scans from genesis, which a local
# node answers and a public RPC's log-range limit may refuse.
APP_IDENTITY_DEPLOY_BLOCK=0
