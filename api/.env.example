NODE_ENV=production
APP_HOST=0.0.0.0
APP_PORT=4000
APP_SENTRY=
# Loggly: subdomain/customer-token (leave empty to disable)
APP_LOGGLY=
APP_REDIS=redis://host.docker.internal:6379
APP_JWT_SECRET=dev-secret-change-in-production

# Shared secret for the entitlement push from the billing service. Must hold
# the SAME value as APP_ENTITLEMENT_SECRET there - it is an HMAC key over the
# push body, so a mismatch does not fail loudly: pushes are rejected as
# unauthenticated and entitlement silently stops flowing.
#
# LEAVE EMPTY when self-hosting: no billing service means every account is
# unconditionally premium, which is the intended behaviour for this build.
APP_ENTITLEMENT_SECRET=

APP_DB_HOST=host.docker.internal
APP_DB_PORT=5432
APP_DB_USERNAME=postgres
APP_DB_PASSWORD=postgres
APP_DB_NAME=address_work

# Must match the host of VITE_API_URL (docker-compose*.yml web service). Comma-separated, no scheme.
APP_TON_ALLOWED_DOMAINS=