# =========================================
# Stage 1: Develop the Node.js API
# =========================================
ARG NODE_VERSION=24.12.0-alpine

# Use a lightweight Node.js image for development
FROM node:${NODE_VERSION} AS dev

# Layout: /app/tsconfig.base.json + /app/api/* (matches api/tsconfig.json extends)
WORKDIR /app

# Enable pnpm (project uses root pnpm-lock.yaml)
RUN corepack enable && corepack prepare pnpm@latest --activate

# Monorepo root install so @app/eslint-config (workspace:*) resolves (same pattern as web/dockerfile.dev)
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY tsconfig.base.json ./
COPY packages/ packages/
COPY api/package.json ./api/

RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --filter "./api..." --filter "@app/api-client..."

COPY api/ ./api/

WORKDIR /app/api

# Expose the port used by the API server
EXPOSE 4000

# Align DB schema with entities, then start the dev server (override CMD in compose if needed)
CMD ["sh", "-c", "pnpm run typeorm:cli -- schema:sync && pnpm run dev"]
