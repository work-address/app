# =========================================
# Stage 1: Build the Node.js API
# =========================================

ARG NODE_VERSION=24.12.0-alpine

# Use a lightweight Node.js image for building
FROM node:${NODE_VERSION} AS builder

# Layout: /app/tsconfig.base.json + /app/api/* so api/tsconfig.json extends ../tsconfig.base.json
WORKDIR /app

# Enable pnpm (project uses root pnpm-lock.yaml)
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy workspace root + eslint-config so workspace:* deps resolve (same pattern as web/dockerfile.prod)
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY tsconfig.base.json ./
COPY packages/ packages/
COPY api/package.json ./api/

# Install api subtree only (root lockfile is authoritative)
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile --filter "./api..." --filter "@app/api-client..."

# Copy the rest of the application source code into the container
COPY api/ ./api/

WORKDIR /app/api

# Stale tsconfig.tsbuildinfo + rimraf build makes composite tsc emit nothing; never copy *.tsbuildinfo (see root .dockerignore)
RUN rm -f tsconfig.tsbuildinfo && pnpm run build

# =========================================
# Stage 2: Run the compiled API
# =========================================

FROM node:${NODE_VERSION} AS runner
ARG GIT_COMMIT=unknown

LABEL org.opencontainers.image.revision="${GIT_COMMIT}"

# Match pnpm workspace paths: api deps symlink into /app/node_modules/.pnpm (must not flatten api/node_modules onto root)
WORKDIR /app/api

ENV NODE_ENV=production

COPY --from=builder /app/api/package.json ./
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/api/node_modules ./node_modules
COPY --from=builder /app/api/build ./build

# typeorm:cli (schema:sync) needs TS sources + tsconfig (ormconfig uses src/entity/*)
COPY --from=builder /app/tsconfig.base.json /app/tsconfig.base.json
COPY --from=builder /app/api/tsconfig.json ./tsconfig.json
COPY --from=builder /app/api/src ./src

# Use a non-root user for security best practices
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001
USER nodejs

# Expose port 4000 to allow HTTP traffic
EXPOSE 4000

# Align DB schema with entities, then start the API server
CMD ["sh", "-c", "npm run typeorm:cli -- schema:sync && node build/server.js"]
