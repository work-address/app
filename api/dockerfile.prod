# =========================================
# Stage 1: Build the Node.js API
# =========================================

ARG NODE_VERSION=24.12.0-alpine

# Use a lightweight Node.js image for building
FROM node:${NODE_VERSION} AS builder

# Layout: /app/tsconfig.base.json + /app/api/* so api/tsconfig.json extends ../tsconfig.base.json
WORKDIR /app

# Enable pnpm (project uses pnpm-lock.yaml)
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy package-related files first to leverage Docker's caching mechanism
COPY tsconfig.base.json ./
COPY api/package.json api/pnpm-lock.yaml ./api/

WORKDIR /app/api

# Install project dependencies (frozen lockfile = reproducible, like npm ci)
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile

# Copy the rest of the application source code into the container
COPY api/ .

# Build the TypeScript application (outputs to /app/api/build)
RUN pnpm run build

# =========================================
# Stage 2: Run the compiled API
# =========================================

FROM node:${NODE_VERSION} AS runner

WORKDIR /app

# Copy package files and production dependencies
COPY --from=builder /app/api/package.json /app/api/pnpm-lock.yaml ./
COPY --from=builder /app/api/node_modules ./node_modules

# Copy the built application
COPY --from=builder /app/api/build ./build

# Use a non-root user for security best practices
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001
USER nodejs

# Expose port 4000 to allow HTTP traffic
EXPOSE 4000

# Start the API server
CMD ["node", "build/server.js"]
