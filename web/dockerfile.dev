# =========================================
# Stage 1: Develop the React.js Application
# =========================================
# Build context: repository root (monorepo)
ARG NODE_VERSION=24.12.0-alpine

# Use a lightweight Node.js image for development
FROM node:${NODE_VERSION} AS dev

# Set the working directory inside the container
WORKDIR /app

# Enable pnpm (project uses pnpm-lock.yaml)
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy workspace files and packages needed for @app/eslint-config
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/ packages/
COPY web/ web/

# Install project dependencies (from monorepo root for workspace resolution)
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install

# Expose the port used by the Vite development server
EXPOSE 3000

# Run dev server from web workspace
WORKDIR /app/web
CMD ["pnpm", "run", "dev"]