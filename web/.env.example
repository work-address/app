VITE_API_URL=https://app.address.work

# The websites a sign-in may return to, comma-separated. Unset means
# https://address.work, plus http://localhost:3000 in development. Set it for a
# self-hosted website, or the sign-in page treats that website's visitors as
# time tracker users and never sends them back.
# VITE_WEBSITE_ORIGINS=https://address.work,http://localhost:3000

# `pnpm dev:demo` runs in demo mode: the app answers itself from in-browser mock
# handlers (src/shared/mock) and needs no backend. `pnpm dev` sets this to
# `false` and talks to the API at VITE_API_URL. A build is off unless
# VITE_DEMO=true (`pnpm build:demo`).
# VITE_DEMO=false
