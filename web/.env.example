VITE_API_URL=https://app.address.work
VITE_WC_PROJECT_ID=your-walletconnect-project-id
VITE_TON_DEV_MANIFEST_URL=https://app.address.work/tonconnect-manifest.json

# `pnpm dev:demo` runs in demo mode: the app answers itself from in-browser mock
# handlers (src/shared/mock) and needs no backend. `pnpm dev` sets this to
# `false` and talks to the API at VITE_API_URL. A build is off unless
# VITE_DEMO=true (`pnpm build:demo`).
# VITE_DEMO=false
