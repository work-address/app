{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "api-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "api"
      ],
      "port": 4000
    },
    {
      "name": "api-dev-4100",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "APP_PORT=4100 npm run dev --prefix api"
      ],
      "port": 4100
    },
    {
      "name": "web-dev-api-4100",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web && VITE_DEMO=false VITE_API_URL= VITE_API_PROXY_TARGET=http://localhost:4100 npx vite --port 8100 --strictPort"
      ],
      "port": 8100
    },
    {
      "name": "web-demo",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web && npx vite --port 8200 --strictPort"
      ],
      "port": 8200
    }
  ]
}
