{
  "name": "work-address",
  "description": "Time tracking and Decentralized Freelance Identity",
  "author": "https://address.work",
  "version": "0.0.1",
  "scripts": {
    "codegen:api-client": "pnpm --filter @app/api-client codegen",
    "test": "pnpm --filter ./api test",
    "agent-tracker:build": "pnpm --filter '@work-address/*' -r build",
    "agent-tracker:test": "pnpm agent-tracker:build && pnpm --filter '@work-address/*' -r test",
    "agent-tracker:demo": "pnpm agent-tracker:build && node scripts/agent-tracker-demo.mjs",
    "agent-tracker:verify-sdk": "node packages/agent-tracker-openclaw/scripts/verify-sdk.mjs",
    "agent-tracker:pack-smoke": "pnpm agent-tracker:build && node scripts/agent-tracker-pack-smoke.mjs",
    "agent-tracker:test-hermes": "cd packages/agent-tracker/bridges/hermes && PYTHONDONTWRITEBYTECODE=1 python3 -m unittest test_bridge.py"
  },
  "prettier": {
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "endOfLine": "auto"
  },
  "workspaces": [
    "api",
    "web"
  ],
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "eslint": "^9",
    "typescript": "5.8.3"
  },
  "pnpm": {
    "overrides": {
      "ws@7": "^7.5.11",
      "ws@8": "^8.21.0",
      "axios": "^1.19.0",
      "multer": "^2.2.0",
      "qs": "^6.15.2"
    }
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
