{
  "name": "@work-address/contracts",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Open marketplace escrow contract for Work Address. Unaudited; not for real funds.",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "deploy:local": "hardhat run scripts/deploy.ts --network hardhat",
    "node": "hardhat node",
    "deploy:localhost": "hardhat run scripts/deploy.ts --network localhost",
    "mint:localhost": "hardhat --network localhost mint",
    "time:advance": "hardhat --network localhost time:advance"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.3",
    "ajv": "^8.20.0",
    "chai": "^4.5.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "mocha": "^12.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
