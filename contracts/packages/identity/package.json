{
  "name": "@work-address/identity",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Builds, presents and checks Work Address profile commitments (profile schema v1): salted 32-leaf Merkle trees, IdentityRegistry commitments, proofs, private exports, presentations and self-signed mode. Browser-safe, no network calls. Unaudited.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "test": "mocha",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noble/curves": "1.2.0",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.3",
    "chai": "^4.5.0",
    "mocha": "^12.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
