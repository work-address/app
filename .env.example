# Docker Compose (docker-compose.yml) reads this file for variable substitution.
# Copy to .env and adjust for your environment, or use scripts/installer.sh on a fresh server.
#
# For local runs with Postgres on the host, use host.docker.internal (not localhost).

APP_DB_HOST=host.docker.internal
APP_DB_PORT=5432
APP_DB_USERNAME=postgres
APP_DB_PASSWORD=
APP_DB_NAME=address_work
APP_JWT_SECRET=dev-secret-change-in-production
APP_SENTRY=
APP_LOGGLY=
