{
  "i18n-ally.localesPaths": ["web/src/shared/i18n/locales"],
  "i18n-ally.keystyle": "flat",
  "i18n-ally.enabledFrameworks": [
    "react",
    "i18next"
  ],
  "files.exclude": {
    "**/node_modules": true
  },
  "search.exclude": {
    "**/node_modules": true
  },
  "js/ts.tsdk.path": "web/node_modules/typescript/lib",
  "js/ts.tsserver.experimental.enableProjectDiagnostics": true,
  "editor.foldingImportsByDefault": true
}
